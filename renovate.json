{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust crates",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false
    }
  ]
}
